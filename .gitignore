/baseline_failures.txt
/smoke_coverage.log

# saipen working memory IS tracked (the 24.07 wipe had no git fallback because
# it wasn't). Only the snapshot generations stay out: they are regenerated on
# every run and git now provides the history they stood in for.
.saipen/snapshots/

# saipen scratch — per-session caches, never committed
.saipen/kitchen/*
# EXCEPT the release-scope records and closure artifacts: the release engine
# stages the reviewed scope identity and the ship closure digest/receipt with
# the release commit, so those must be trackable.
!.saipen/kitchen/release_scope/
!.saipen/kitchen/digest.md
!.saipen/kitchen/release_receipt.json

# agent runtime dir (workbuddy skill host)
.workbuddy-ai/

# stray i18n extraction artifacts (HUNT T-1079)
/placeholders.json
/unique_keys.json


# saipen engine recovery scratch (HUNT T-1090) - per-session op journals + FAIL receipts, regenerated by engine
.saipen/recovery/settled/
.saipen/recovery/conformance/*_FAIL.json

# codebase-memory-mcp index artifact — a 5+ MB regenerable compressed graph,
# rebuilt by index_repository on demand. Nothing reads it that cannot re-derive it.
.codebase-memory/

# saitranslate re-cut scratch scripts (per-session generators, same class as
# .saipen/kitchen/*: regenerated by the producer role, never release input)
.saipen/saitranslate/kitchen/*.py

.venv/
__pycache__/
*.pyc
.pytest_cache/
# Release staging clones: a `git clone` of this repo used to assemble a release
# candidate. The nested clone carries its own .git, so `git ls-files --others
# --directory` reports it as a directory entry, and the SAIPEN source identity
# refuses a path carrying a trailing separator. Ignored here so the debris
# never reaches the release engine; the directory itself is left on disk.
.release-fp-*/
*.db
local_data_v15.db
crash.log
*.bat
nul
*.token
*.bak
fastprompter_ipc.token
data/
build/
nuitka-crash-report.xml
error.log

src/test_dir/

# large local archives — never commit
*.rar
*.7z
*.zip

# scratch artifacts from other tools - not part of the project
.freebuff/
src/fastprompter/_extract.txt

# one-off repair/scratch scripts at the repo root — never release
/fix_*.py
/patch_*.py
/patch.py
/scratch.py
/bump.py
/bump_changelog.py
/log_ship.py
/mark_board.py
/prune_board.py
/rm_converge.py
/remove_bom.py
/write_digest.py
/update_state.py
/update_state2.py
/finish_state.py
/smoke_coverage.py
/append_path_tests.py
/original.py
/test_lock.py
/test_palette.py
/test_timer_debug.py
/test_timer_load.py
/test_timer_to_dict.py
/test_timers_patch.py
/diff.txt
/fh_dump.txt
/sc_shortcut.txt
/validate_out.txt
/baseline_failures.txt
/smoke_coverage.log

# saipen working memory IS tracked (the 24.07 wipe had no git fallback because
# it wasn't). Only the snapshot generations stay out: they are regenerated on
# every run and git now provides the history they stood in for.
.saipen/snapshots/

# saipen scratch — per-session caches, never committed
.saipen/kitchen/*
# EXCEPT the release-scope records and closure artifacts: the release engine
# stages the reviewed scope identity and the ship closure digest/receipt with
# the release commit, so those must be trackable.
!.saipen/kitchen/release_scope/
!.saipen/kitchen/digest.md
!.saipen/kitchen/release_receipt.json

# agent runtime dir (workbuddy skill host)
.workbuddy-ai/

# stray i18n extraction artifacts (HUNT T-1079)
/placeholders.json
/unique_keys.json


# saipen engine recovery scratch (HUNT T-1090) - per-session op journals + FAIL receipts, regenerated by engine
.saipen/recovery/settled/
.saipen/recovery/conformance/*_FAIL.json

# saipen machine-local in-flight state (T-1241): OS writer locks, liveness
# cache, per-operation journals and staged payloads are process-local, carry no
# canonical truth, and are regenerated by the engine. They must never enter a
# public release cohort.
.saipen/locks/
.saipen/cache/
.saipen/recovery/ops/

# codebase-memory-mcp index artifact — a 5+ MB regenerable compressed graph,
# rebuilt by index_repository on demand. Nothing reads it that cannot re-derive it.
.codebase-memory/

# saitranslate re-cut scratch scripts (per-session generators, same class as
# .saipen/kitchen/*: regenerated by the producer role, never release input)
.saipen/saitranslate/kitchen/*.py

/_RECOVERY_*/
db_dump.json

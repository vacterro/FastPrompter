+def _head_is_ancestor(receipt_head, live_head, root: Path) -> bool:
+    """True when ``receipt_head`` is an ancestor of ``live_head`` in this repo.
+
+    A closure receipt is stamped with the HEAD that existed when it was minted.
+    Because ``freshness._is_saipen_path`` excludes ``.saipen/`` from the
+    git-delta-v1 fingerprint, a protocol-only commit advances HEAD while
+    leaving the fingerprint byte-identical. Requiring exact HEAD equality
+    therefore rejects evidence the fingerprint still fully vouches for, and
+    makes a fresh clone unsatisfiable: committing a receipt advances HEAD and
+    invalidates that same receipt. Accepting an ancestor restores the
+    provenance half of the binding WITHOUT loosening the load-bearing half --
+    callers must still match ``source_tree_fingerprint`` exactly, so no
+    stale-code evidence is admitted. Ancestry is checked against this
+    repository, so a receipt from a divergent branch or an unrelated clone
+    stays rejected.
+    """
+    if not receipt_head or not live_head:
+        return False
+    if receipt_head == live_head:
+        return True
+    try:
+        completed = subprocess.run(
+            [
+                "git",
+                "-C",
+                str(root),
+                "merge-base",
+                "--is-ancestor",
+                str(receipt_head),
+                str(live_head),
+            ],
+            capture_output=True,
+            timeout=VALIDATOR_CAPTURE_TIMEOUT,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return False
+    return completed.returncode == 0
+
+
+def _receipt_binds_current_tree(receipt: dict, identity: dict, root: Path) -> bool:
+    """The single binding rule shared by closure-evidence admission and reuse.
+
+    The content fingerprint must match exactly; the HEAD may match exactly or
+    be an ancestor of the live HEAD. Both halves are load-bearing, and this
+    one helper keeps them from drifting apart at the two call sites.
+    """
+    if receipt.get("source_tree_fingerprint") != identity["source_tree_fingerprint"]:
+        return False
+    return _head_is_ancestor(
+        receipt.get("source_head"), identity["source_head"], root
+    )
+

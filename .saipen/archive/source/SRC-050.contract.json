    "SRC-050:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c shift \u0437\u0430\u0436\u0442\u0438\u0435 \u0435\u0441\u043b\u0438 \u043d\u0430\u0432\u0451\u043b \u043d\u0430 ai limits meter \u043d\u0430 topbar \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u0438\u0433\u043d\u043e\u0440\u044f \u0444\u0438\u043b\u044c\u0442\u0440\u044b \u0447\u0442\u043e\u0431\u044b \u0432\u0438\u0434\u0435\u0442\u044c.\n\n\u2022 Silo Folder \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043a\u0430\u043a \u0432 \u043c\u0430\u0439\u043d\u043a\u0440\u0444\u0442\u0435 + \u043f\u043e\u0434 \u0442\u0435\u043c\u0443 \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c\u0441\u044f + 128 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0438\u043b\u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u043b\u0443\u0447\u0448\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043a\u043e\u043a \u043c\u0435\u0441\u0442\u0430\u0445 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.\n\n\u2022 \u0422\u0430\u043c \u0430\u0439\u0442\u0435\u043c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0435\u0440\u0435\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0443\u043c\u0435\u0442\u044c \u043a\u0430\u043a \u0432 \u0438\u0433\u0440\u0435 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435."
    }
